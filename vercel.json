{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cp -r api-version1/* api/ 2>/dev/null || xcopy api-version1 api /E /I /Y",
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}