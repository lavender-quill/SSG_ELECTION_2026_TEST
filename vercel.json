{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "PHP_VERSION": "8.2"
  },
  "services": {
    "app": {
      "root": "api-version1",
      "runtime": "php",
      "entrypoint": "index.php",
      "buildCommand": "echo 'Building PHP application'",
      "devCommand": "php -S localhost:3000"
    }
  },
  "rewrites": [
    {
      "source": "/((?!data|logs|artifacts).*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}