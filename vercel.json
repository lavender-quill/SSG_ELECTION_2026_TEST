{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api-version1/index.php"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!data|logs|artifacts).*)",
      "destination": "/api-version1/index.php"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}